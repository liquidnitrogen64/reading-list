<file path="login/styles.css">
:root {
    color-scheme: light;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    color: #1f2937;
    background: #f3f6fb;
    font-synthesis: none;
    text-rendering: optimizeLegibility;
}

* {
    box-sizing: border-box;
}

body {
    min-width: 320px;
    min-height: 100vh;
    margin: 0;
    padding: 2rem 1rem;
    display: grid;
    place-items: center;
    background:
        radial-gradient(ellipse at top, #e8efff 0, transparent 58%),
        #f3f6fb;
}

.auth-card {
    width: min(100%, 26rem);
    padding: clamp(1.5rem, 5vw, 2.5rem);
    border: 1px solid #e2e8f0;
    border-radius: 1rem;
    background: #fff;
    box-shadow: 0 1.25rem 3.5rem rgb(31 41 55 / 10%);
}

.auth-card h1 {
    margin: 0;
    color: #172554;
    font-size: clamp(1.65rem, 5vw, 2rem);
    line-height: 1.2;
}

.lead {
    margin: 0.75rem 0 1.75rem;
    color: #64748b;
    line-height: 1.55;
}

.input-wrapper {
    position: relative;
    margin-bottom: 1rem;
}

.input-wrapper input {
    width: 100%;
    min-height: 3.25rem;
    padding: 1.1rem 0.9rem 0.45rem;
    border: 1px solid #cbd5e1;
    border-radius: 0.55rem;
    outline: none;
    background: #fff;
    color: #1f2937;
    font: inherit;
    transition: border-color 150ms ease, box-shadow 150ms ease;
}

.input-wrapper input:focus {
    border-color: #4f6fce;
    box-shadow: 0 0 0 3px rgb(79 111 206 / 16%);
}

.input-wrapper > label {
    position: absolute;
    top: 0.98rem;
    left: 0.9rem;
    color: #64748b;
    font-size: 0.95rem;
    line-height: 1;
    pointer-events: none;
    transform-origin: left top;
    transition: transform 150ms ease, color 150ms ease;
}

.input-wrapper input:focus + label,
.input-wrapper input:not(:placeholder-shown) + label {
    color: #4f6fce;
    transform: translateY(-0.55rem) scale(0.78);
}

.input-wrapper:has(.toggle-btn) input {
    padding-right: 4.5rem;
}

.toggle-btn {
    position: absolute;
    top: 0.8rem;
    right: 0.65rem;
    padding: 0.35rem 0.45rem;
    border: 0;
    border-radius: 0.35rem;
    background: transparent;
    color: #405cb2;
    font: inherit;
    font-size: 0.85rem;
    cursor: pointer;
}

.toggle-btn:hover {
    background: #eef2ff;
}

.helper {
    margin-top: 0.4rem;
    color: #64748b;
    font-size: 0.8rem;
    line-height: 1.4;
}

.login-options-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: 0.25rem 0 1.25rem;
    font-size: 0.9rem;
}

.checkbox {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #475569;
    cursor: pointer;
}

.checkbox input {
    width: 1rem;
    height: 1rem;
    margin: 0;
    accent-color: #4f6fce;
}

.muted-link {
    color: #405cb2;
    text-decoration: none;
}

.muted-link:hover {
    text-decoration: underline;
}

.btn {
    width: 100%;
    min-height: 3rem;
    padding: 0.75rem 1rem;
    border: 0;
    border-radius: 0.55rem;
    background: #405cb2;
    color: #fff;
    font: inherit;
    font-weight: 650;
    cursor: pointer;
    transition: background-color 150ms ease, transform 150ms ease;
}

.btn:hover {
    background: #344c99;
}

.btn:active {
    transform: translateY(1px);
}

#create-account {
    margin-top: 1.25rem;
    color: #64748b;
    text-align: center;
    font-size: 0.9rem;
}

#formError {
    min-height: 1.25rem;
    margin-top: 0.75rem;
    color: #b42318;
    text-align: center;
}

:focus-visible {
    outline: 3px solid #7c93e6;
    outline-offset: 3px;
}

@media (max-width: 24rem) {
    .login-options-row {
        align-items: flex-start;
        flex-direction: column;
        gap: 0.75rem;
    }
}

@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        scroll-behavior: auto !important;
        transition-duration: 0.01ms !important;
    }
}

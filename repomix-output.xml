<file path="login/index.html">
<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title> Sign In </title>
    <meta name="description" content="Sign in to acess your reading list and book journal.">
    <meta name="robots" content="noindex, nofollow">
    <link rel="stylesheet" href="./styles.css">
</head>

<body class="auth-page login-page">

    <main class="card auth-card login-card" role="main" aria-labelledby="signin-heading">
        <h1 id="signin-heading">Sign-In</h1>
        <p class="lead">Welcome back. Enter your account details to continue.</p>

        <form id="loginForm" action="#" method="post" novalidate>
            <div class="input-wrapper">
                <input id="email" name="email" type="email" autocomplete="email" required placeholder=" "
                    inputmode="email" aria describedby="emailHelp" />
                <label for="email">E-mail Adress</label>
                <div id="emailHelp" class="helper" aria-hidden="true">We will never share your e-mail.</div>
            </div>

            <div class="input-wrapper">
                <input id="password" name="password" type="password" autocomplete="current-password" required
                    minlength="8" placeholder=" " aria-describedby="passwordHelp" />
                <label for="password">Password</label>
                <div id="emailHelp" class="helper" aria-hidden="true">We will never share your e-mail</div>
            </div>

            <div class="input-wrapper">
                <input id="password" name="password" type="password" autocomplete="current-password" required
                    minlength="8" placeholder=" " aria-describedby="passwordHelp" />
                <label for="password">Password</label>
                <button type="button" id="togglePassword" class="icon-btn toggle-btn" aria-pressed="false"
                    title="Show password">Show</button>
                <div id="passwordHelp" class="helper">Minimum of 8 characters.</div>
            </div>

            <div id="login-options" class="row login-options-row">
                <label class="checkbox">
                    <input type="checkbox" id="remember" name="remember" />
                    <span class="checkbox-custom" aria-hidden="true"></span>
                    <span> Remember me</span>
                </label>
                <a class="muted-link" href="#"
                    onClick="alert('Please contact support if you wish to change your password.')">Forgot password?</a>
            </div>

            <div>
                <button class="btn" type="submit">Sign in</button>
                <div>

                    <div id="create-account">
                        New to Marginalia? <a href="../signup/index.html" class="muted-link">Create an account</a>
                    </div>

                    <div id="formError" class="error" role="alert" aria-live="assertive" style="display:none"></div>
        </form>
    </main>
</body>

</html>
